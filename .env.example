# Copy to .env (repo root) and fill in real values. Never commit the real
# .env file — it's covered by .gitignore. Used by `docker compose up`.
#
# These mirror backend/.env.example; see that file for the backend's own
# description of each var when running outside Docker.

# Single admin account, seeded on first startup if the User table is empty.
# ADMIN_USERNAME is always lowercased. ADMIN_NAME is optional (defaults to
# ADMIN_USERNAME capitalized).
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# JWT signing secret. Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insecure-dev-secret-change-me

# Minutes before an issued JWT expires.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLAlchemy database URL. Path is inside the container; ./data on the host
# is bind-mounted to /app/backend/data so the SQLite file persists across
# `docker compose` restarts/redeploys/image pulls. Leave as-is unless you
# know you need something else.
DATABASE_URL=sqlite:///./data/livro_caixa.db

# Comma-separated list of origins allowed to call the API (CORS). Since this
# image serves the frontend and API from the same origin, the default is
# usually enough; add extra origins if you access it via another host/port.
CORS_ORIGINS=http://localhost:8000

# --- Container-specific ---

# Host port to expose the app on (container always listens on 8000).
APP_PORT=8000
